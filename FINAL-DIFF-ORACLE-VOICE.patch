+ALTER TABLE "OracleVoiceprint" ADD CONSTRAINT "OracleVoiceprint_speakerProfileId_fkey" FOREIGN KEY ("speakerProfileId") REFERENCES "OracleSpeakerProfile"("id") ON DELETE CASCADE ON UPDATE CASCADE;
