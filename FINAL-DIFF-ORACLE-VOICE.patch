+    "id" TEXT NOT NULL,
+    "sessionId" TEXT NOT NULL,
+    "chunkIndex" INTEGER NOT NULL,
+    "mimeType" TEXT NOT NULL DEFAULT 'audio/wav',
+    "storageKey" TEXT,
+    "bytesSha256" TEXT,
+    "durationMs" INTEGER,
+    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "OracleVoiceChunk_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateTable
