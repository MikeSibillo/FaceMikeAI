{
  "name": "ai-aztec",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @ai-aztec/db exec prisma generate",
    "db:migrate": "pnpm --filter @ai-aztec/db exec prisma migrate deploy",
    "db:push": "pnpm --filter @ai-aztec/db exec prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
